	measure 'On-time Delivery Rate' = ```
			
			
			VAR on_time_delivery_count =
			    CALCULATE(
			        DISTINCTCOUNT(factSales[order_id]), 
			        factSales[order_status] = "delivered",
			        factSales[date_delivered_customer] <= factSales[date_estimated_delivery]
			    )
			
			VAR total_delivered_orders_count = 
			    CALCULATE(
			        DISTINCTCOUNT(factSales[order_id]), 
			        factSales[order_status] = "delivered"
			    )
			
			RETURN 
			
			    DIVIDE(on_time_delivery_count, total_delivered_orders_count, 0)
			
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Logistics
		lineageTag: 73ea4729-2cc3-45b3-b638-25ba2e2c6054

	measure 'Average Delivery Days' = ```
			
			
			    AVERAGEX(
			        FILTER(
			            factSales,
			            factSales[order_status] == "delivered"
			            && factSales[date_delivered_customer] >= factSales[datetime_purchase]
			            && NOT(ISBLANK(factSales[date_delivered_customer]))
			            && NOT(ISBLANK(factSales[datetime_purchase]))
			        ),
			
			        DATEDIFF(
			            factSales[datetime_purchase],
			            factSales[date_delivered_customer],
			            DAY
			        )
			    )
			    
			```
		lineageTag: 110b044b-c605-4bb1-93ea-222e3b38cf65

