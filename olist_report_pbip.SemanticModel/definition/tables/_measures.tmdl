	measure 'Payment Comissions' =
			
			CALCULATE(
			    SUMX(
			        dimOrders,
			        (dimOrders[credit_card_amount] * 0.035) +
			        (dimOrders[boleto_amount]      * 0.015) +
			        (dimOrders[voucher_amount]     * 0.020) +
			        (dimOrders[debit_card_amount]       * 0.010)
			    ),
			        factSales[order_status] = "delivered",
			        CROSSFILTER(factSales[order_id], dimOrders[order_id], Both)
			)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Financial
		lineageTag: c5f286ce-ab5d-44d3-99c9-95ce9e071d5d

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

