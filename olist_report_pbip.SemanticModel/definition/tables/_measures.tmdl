	measure 'Net Average Order Value' = ```
			
			VAR delivered_orders = 
			
			CALCULATE(
			    DISTINCTCOUNT(factSales[order_id]),
			    factSales[order_status] = "delivered"
			)
			RETURN
			    DIVIDE([Delivered GMV], delivered_orders, 0)
