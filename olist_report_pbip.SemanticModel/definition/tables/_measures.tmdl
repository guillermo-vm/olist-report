	measure 'Top Category Name Margin' = ```
			
			CALCULATE(
			    SELECTEDVALUE(supCategoryEnglishName[Product Category English]),
			    TOPN(
			        1, 
			        ALLSELECTED(supCategoryEnglishName[Product Category English]), 
			        [Net Margin], 
			        DESC
			    )
			)
			```
		lineageTag: 5841d8bb-2b7a-405a-b0e7-4a771ca824c2

	measure '10 Category Rank Colornet margin' = ```
			
			VAR CategoryRank = 
			    RANKX(
			        ALLSELECTED(supCategoryEnglishName[Product Category English]),
			        [Net Margin],
			        ,
			        DESC,
			        Dense
			    )
			RETURN
			    SWITCH(
			        CategoryRank,
			        1,  "#0542E6", -- Rank 1 (Highest Margin)
			        2,  "#2862EE",
			        3,  "#4A82F6",
			        4,  "#6F9CFA",
			        5,  "#94B5FF",
			        6,  "#BAAAEA",
			        7,  "#E0A172",
			        8,  "#DD864C",
			        9,  "#D96B27",
			        10, "#B04610", -- Rank 10
			        BLANK()       -- Categories outside Top 10 stay uncolored
			    )
			```
		displayFolder: Formatting
		lineageTag: a3d0e8e5-1863-48fd-9bab-f01f4e16c9cf

