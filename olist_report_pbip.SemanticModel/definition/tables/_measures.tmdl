	measure 'Pareto category split revenue' = ```
			
			
			VAR revenue_rank = 
			    RANKX(
			        ALLSELECTED(dimProducts[product_category_name]),
			        [Olist Net Revenue],
			        ,
			        DESC,
			        Dense
			    )
			
			
			
			```
		displayFolder: Financial
