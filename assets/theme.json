{
  "name": "Olist Corporate Theme",
  "dataColors": [
    "#0A4EE4",
    "#001647",
    "#D2B5A1",
    "#00A389",
    "#6C5CE7",
    "#F39C12",
    "#E03C31",
    "#7F8C8D"
  ],
  "background": "#F4F7F9",
  "foreground": "#1D1C1D",
  "tableAccent": "#0A4EE4",
  "visualStyles": {
    "*": {
      "*": {
        "outspacePane": [
          {
            "backgroundColor": { "solid": { "color": "#F4F7F9" } }
          }
        ],
        "filterCard": [
          {
            "textBoxSize": 10,
            "appliedColor": { "solid": { "color": "#0A4EE4" } }
          }
        ]
      }
    },
    "page": {
      "*": { "background": [{ "color": { "solid": { "color": "#F4F7F9" } }, "transparency": 0 }] }
    }
  }
}